generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Pipeline states for lead processing
enum PipelineState {
  NEW
  SELECTED
  CONTACTING
  SENT
  REPLIED
  INTERESTED
  NOT_INTERESTED
  FOLLOW_UP
  DISCARDED
  REQUIRES_HUMAN
  MEETING_BOOKED
  INVALID
}

model Usuario {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Lead {
  id              Int           @id @default(autoincrement())
  nombre          String
  telefono        String?
  sitioWeb        String?
  correo          String?
  direccion       String?
  categoria       String?
  terminoBusqueda String
  ubicacion       String? // Estado/ciudad de la búsqueda
  calificacion    Float?
  reviews         Int?
  lat             Float?
  lng             Float?
  redesSociales   Json?
  fuente          String?       @default("maps")
  status          String        @default("active") // "active" o "discarded"
  pipelineState   PipelineState @default(NEW) // Pipeline stage for contact flow
  contactoEstado  Json? // Guarda estado de contacto: { correo: false, whatsapp: false, llamada: false, estado: "En Proceso" }
  creadoEn        DateTime      @default(now())

  // Relación con mensajes enviados
  mensajes LeadMensaje[]
  
  // Historial de la conversación por correo
  correos  EmailMessage[]
}

model EmailMessage {
  id          Int      @id @default(autoincrement())
  leadId      Int
  isIncoming  Boolean  @default(false) // true si es una respuesta del cliente, false si lo mandó el bot
  subject     String?
  bodyText    String
  sentAt      DateTime @default(now())
  
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model CampanaCorreo {
  id       Int      @id @default(autoincrement())
  nombre   String
  asunto   String
  cuerpo   String // Plantilla HTML o texto
  estado   String   @default("draft") // "draft", "sending", "completed"
  creadoEn DateTime @default(now())

  mensajes LeadMensaje[]
}

model LeadMensaje {
  id        Int       @id @default(autoincrement())
  leadId    Int
  campanaId Int
  estado    String    @default("pending") // "pending", "sent", "opened", "replied", "failed"
  mensajeId String? // ID devuelto por Resend (para trackear)
  enviadoEn DateTime?
  error     String?

  lead    Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campana CampanaCorreo @relation(fields: [campanaId], references: [id], onDelete: Cascade)
}

model InegiLead {
  id              Int      @id @default(autoincrement())
  nombre          String
  telefono        String?
  sitioWeb        String?
  correo          String?
  direccion       String?
  categoria       String?
  terminoBusqueda String
  ubicacion       String?
  lat             Float?
  lng             Float?
  status          String   @default("active") // "active" o "discarded"
  creadoEn        DateTime @default(now())
}

model MapsLead {
  id              Int      @id @default(autoincrement())
  nombre          String
  telefono        String?
  sitioWeb        String?
  correo          String?
  direccion       String?
  categoria       String?
  terminoBusqueda String
  ubicacion       String?
  calificacion    Float?
  reviews         Int?
  lat             Float?
  lng             Float?
  redesSociales   Json?
  fuente          String?  @default("maps")
  status          String   @default("active")
  creadoEn        DateTime @default(now())
}

model AutoPilotConfig {
  id              Int      @id @default(1)

  // Switches de Automatización
  globalActive    Boolean  @default(false)
  phase1Active    Boolean  @default(false) // Extracción INEGI -> En Proceso
  phase2Active    Boolean  @default(false) // Envío de Correos y Monitoreo
  phase3Active    Boolean  @default(false) // Clasificación IA y Auto-Respuesta

  // Configuración de Envío
  batchSize           Int      @default(50)
  delaySeconds        Int      @default(30)
  dailyLimit          Int      @default(200)    // Máximo de correos a enviar por día
  batchCooldownHours  Float    @default(4)      // Horas de espera entre lotes (ej. 4 horas)
  sentTodayCount      Int      @default(0)      // Contador de correos enviados hoy
  sentTodayDate       String?                   // Fecha del último reset (YYYY-MM-DD)
  templateSubject     String   @default("Mantenimiento y Recubrimiento Anticorrosivo HVAC")
  templateHtml        String   @default("<h1>Hola, {{nombre_empresa}}</h1><p>Somos Infiniguard, especialistas en recubrimiento anticorrosivo y mantenimiento para sistemas HVAC...</p>")

  // Perfil de empresa para que la IA tenga contexto
  companyName     String   @default("Infiniguard")
  companyContext  String   @default("Somos Infiniguard, ofrecemos servicios de reubicación, mantenimiento y recubrimiento anticorrosivo para sistemas HVAC industriales. Nuestros clientes son hoteles, hospitales, plazas comerciales y plantas industriales en zonas costeras o de alta corrosión.")
  availability    String   @default("Lunes a Viernes, 9:00am - 6:00pm (Hora de México). Para agendar, puede responder este correo o ir a: [LINK_CALENDLY]")
  notifyEmail     String?  // Correo del jefe donde se mandan alertas
  
  // Gmail Reader Bot
  gmailAccessToken    String?  // OAuth token de Gmail (se guarda encriptado idealmente)
  gmailRefreshToken   String?
  
  updatedAt       DateTime @updatedAt
}
