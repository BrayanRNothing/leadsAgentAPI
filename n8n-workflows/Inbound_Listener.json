      "typeVersion": 4.1,
      "position": [
        450,
        300
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "Avisar al Backend Node",
            "type": "main",
            "index": 0
