            {
              "name": "text",
              "value": "={{ $json.textPlain }}"
            },
            {
              "name": "threadId",
              "value": "={{ $json.threadId }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-request-id",
      "name": "Avisar al Backend Node",
